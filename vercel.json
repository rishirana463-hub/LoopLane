{
  "framework": "vite",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "rewrites": [{"source":"/((?!\\.well-known/|_vercel/|assets/|data/|fonts/|sounds/|social-card\\.|sw.js|workbox-|manifest.webmanifest|logo.svg|icon-).*)", "destination":"/index.html"}],
  "headers": [
    {"source":"/(.*)", "headers":[{"key":"Referrer-Policy","value":"strict-origin"}]},
    {"source":"/sw.js", "headers":[{"key":"Cache-Control","value":"no-cache"}]}
  ]
}
